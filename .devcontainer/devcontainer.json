{
  "name": "view-service",
  "dockerFile": "../Dockerfile",
  "context": "..",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "openai.chatgpt"
      ],
      "settings": {}
    }
  },
  "forwardPorts": [8085],
  "postCreateCommand": "pip install -r requirements.txt",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  }
}
